# Environment of the server. Copy to .env for local development (outside
# production, main.go loads .env; in production the platform sets these).

ENVIRONMENT=development
HTTP_PORT=8081

# Postgres; docker-compose's postgres service is created with these.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=playhoot
DATABASE_PASSWORD=change-me
DATABASE_NAME=playhoot
DATABASE_SSL_MODE=disable

# Object storage of game version content. Locally, docker-compose's gcs
# emulator, selected by STORAGE_EMULATOR_HOST (unset in production).
GCS_PROJECT_ID=playhoot-local
GCS_BUCKET=playhoot-dev
STORAGE_EMULATOR_HOST=http://localhost:4443
# The frontend repository checkout whose game tools build DRAFT revisions
# (play/session/internal/gamebuild); unset, every build fails as the
# platform's. GAME_TOOLCHAIN_TEST_DIR runs the gated test of the real
# toolchain.
GAME_TOOLCHAIN_DIR=../playhoot_frontend
# GAME_TOOLCHAIN_TEST_DIR=../playhoot_frontend
# The bucket the object storage tests use, when set
# (play/session/internal/objectstore).
# GCS_TEST_PROJECT_ID=playhoot-local
# GCS_TEST_BUCKET=playhoot-test

# Browser origins allowed to call the REST API (CORS) and to open live
# WebSocket connections besides the server's own: comma-separated origins
# (scheme://host[:port], such as https://play.example.com), or * for any.
# Unset allows none. Any origin locally; in production, the platform's web
# origin.
CORS_ALLOWED_ORIGINS=*
WEBSOCKET_ALLOWED_ORIGINS=*

# Optional capacity and tuning; unset takes the defaults (api/README.md,
# play/CURRENT_STATE.md).
# TRUSTED_PROXY_HOPS=1
# LIVE_MAX_CONNECTIONS=2000
# RUNTIME_MAX_LIVE_SESSIONS=500
# PLAY_MAX_ACTIVE_SESSIONS_PER_CREATOR=1
# SANDBOX_MAX_CONTEXTS=
# SANDBOX_MAX_CONCURRENT_EXECUTIONS=
# REPLAY_STATE_SAMPLE_EVERY_N_TICKS=
# REPLAY_CHUNK_DURATION=
# REPLAY_MAX_PENDING_CHUNKS=

# Identity. The key signs access tokens (at least 32 bytes); required in
# production, generated at startup when unset elsewhere (access tokens then
# end with the process; refresh tokens survive it).
# IDENTITY_ACCESS_TOKEN_KEY=
# Enables the fictitious local sign-in provider (accounts without Google, for
# development and tests). The server refuses to start with it unless ENVIRONMENT
# is development, local or test.
IDENTITY_LOCAL_PROVIDER=true
# The web's sign-in completion route, where provider callbacks send the
# browser. Required in production; defaults to /sign-in/complete on the
# server's own origin (the web's development server proxies the API).
# WEB_SIGN_IN_COMPLETE_URL=
# Google sign-in: the OAuth client from Google Cloud Console, all three or none.
# The redirect URL is the callback exactly as registered in Google, ending in
# /v1/identity/login/google/callback (in development, through the web's dev
# server, for example http://localhost:5173/v1/identity/login/google/callback).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=
