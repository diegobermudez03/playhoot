{
  "about": "Runtime manifests the backend (play/session/internal/business/manifest Parse, with play/internal/business/inputs and commands) and the SDK build (packages/game-core validateManifest in playhoot_frontend) must decide the same way, with each field's default as the backend keeps it. This file is kept identical in both repositories; each side's test checks the other's copy when both checkouts are side by side.",
  "cases": [
    {
      "name": "minimal manifest",
      "manifest": {
        "schema_version": 1,
        "players": {
          "min": 1,
          "max": 4
        }
      },
      "valid": true,
      "defaults": {
        "inputs": {},
        "commands": {}
      }
    },
    {
      "name": "schema_version other than 1",
      "manifest": {
        "schema_version": 2,
        "players": {
          "min": 1,
          "max": 4
